# Copy to .env and change the password BEFORE the first "make up".
# SQL Server needs 8+ chars with upper case, lower case, a digit and a symbol.
# Avoid $ and quotes in the password.
MSSQL_SA_PASSWORD=Greenhouse_Dev_2026!
SQL_DATABASE=GreenhouseDW
SQL_USER=sa
ODBC_DRIVER=ODBC Driver 18 for SQL Server
# Only used if you run the Python scripts directly on your machine instead of via Docker:
SQL_SERVER=127.0.0.1,1433
